<resources>
    <!-- Tema base mínimo para a Activity (Compose usa MaterialTheme) -->
    <style name="Theme.Nexo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Cores básicas AppCompat -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_variant</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="colorError">@color/error</item>

        <!-- Window -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Tela de splash/bootstrap -->
    <style name="Theme.Nexo.Splash" parent="Theme.Nexo">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>